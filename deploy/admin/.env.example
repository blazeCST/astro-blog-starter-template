# Domain used for the admin dashboard
ADMIN_DOMAIN=admin.example-school.org

# Postgres settings
POSTGRES_DB=school_cms
POSTGRES_USER=school_admin
POSTGRES_PASSWORD=change_this_db_password

# Directus app secrets (generate long random values)
DIRECTUS_SECRET=replace_with_long_random_secret
DIRECTUS_KEY=replace_with_32_char_random_key

# Initial admin account
DIRECTUS_ADMIN_EMAIL=it-admin@example-school.org
DIRECTUS_ADMIN_PASSWORD=change_this_admin_password
