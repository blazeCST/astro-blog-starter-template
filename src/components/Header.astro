---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/services">Services</HeaderLink>
			<HeaderLink href="/shop">Shop</HeaderLink>
			<HeaderLink href="/support">Support</HeaderLink>
			<HeaderLink href="/about">About Us</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<HeaderLink href="/admin">Admin</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		margin: 0;
		padding: 0 1em;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(var(--gray), 0.2);
	}

	h2 {
		margin: 0;
		font-size: 1rem;
		letter-spacing: 0.03em;
		white-space: nowrap;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1080px;
		margin: 0 auto;
	}

	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		font-size: 0.95rem;
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--accent-dark);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	@media (max-width: 900px) {
		nav {
			padding: 0.3rem 0;
			align-items: flex-start;
			flex-direction: column;
		}

		.internal-links {
			width: 100%;
			justify-content: space-between;
		}

		nav a {
			padding: 0.7rem 0.4rem;
		}
	}
</style>
