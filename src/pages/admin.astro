---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { products } from '../data/siteData';

const starterProducts = products.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | Admin Dashboard`}
			description="Admin dashboard for creating website pages and products for ProTech IT Support."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">Admin Dashboard</p>
				<h1>Restricted portal for administrators only</h1>
				<p>
					Use this dashboard to create product records and website page drafts. Sign in with the admin passcode
					to unlock editing features.
				</p>
			</section>

			<section class="admin-auth" id="auth-box">
				<h2>Admin Sign In</h2>
				<p>Demo passcode: <code>admin123</code></p>
				<form id="auth-form">
					<label>
						Admin passcode
						<input type="password" name="passcode" placeholder="Enter passcode" required />
					</label>
					<button type="submit">Unlock Dashboard</button>
				</form>
				<p id="auth-message" class="status"></p>
			</section>

			<section class="dashboard hidden" id="dashboard">
				<div class="dashboard-topbar">
					<h2>Control Panel</h2>
					<button type="button" id="logout">Lock dashboard</button>
				</div>

				<div class="tab-buttons" role="tablist">
					<button type="button" class="active" data-tab="products">Manage Products</button>
					<button type="button" data-tab="pages">Create New Website Page</button>
				</div>

				<div class="tab-content active" id="tab-products">
					<div class="dashboard-grid">
						<form id="product-form" class="admin-form">
							<h3>Add Product</h3>
							<label>
								Product name
								<input name="name" type="text" required placeholder="Example: Managed Switch 24-Port" />
							</label>
							<label>
								SKU
								<input name="sku" type="text" required placeholder="PT-SW-24PRO" />
							</label>
							<label>
								Price (USD)
								<input name="price" type="number" min="0" required placeholder="499" />
							</label>
							<label>
								Stock
								<input name="stock" type="number" min="0" required placeholder="15" />
							</label>
							<label>
								Tag
								<input name="tag" type="text" placeholder="New / Security / Promotion" />
							</label>
							<label>
								Description
								<textarea
									name="description"
									rows="4"
									placeholder="Short product summary"
									required
								></textarea>
							</label>
							<button type="submit">Save Product</button>
							<p class="status" id="product-status"></p>
						</form>

						<section class="data-list">
							<h3>Current Product Catalog</h3>
							<ul id="product-list">
								{starterProducts.map((product) => (
									<li>
										<strong>{product.name}</strong>
										<span>{product.sku}</span>
										<span>${product.price}</span>
										<span>{product.stock} units</span>
									</li>
								))}
							</ul>
						</section>
					</div>
				</div>

				<div class="tab-content" id="tab-pages">
					<div class="dashboard-grid">
						<form id="page-form" class="admin-form">
							<h3>Create Site Page Draft</h3>
							<label>
								Page title
								<input name="title" type="text" placeholder="Example: Managed Backup Service" required />
							</label>
							<label>
								URL slug
								<input name="slug" type="text" placeholder="managed-backup-service" required />
							</label>
							<label>
								Page category
								<select name="category">
									<option>Landing</option>
									<option>Service</option>
									<option>Product</option>
									<option>Knowledge Base</option>
								</select>
							</label>
							<label>
								Draft summary
								<textarea
									name="summary"
									rows="5"
									placeholder="Describe what this page should contain"
									required
								></textarea>
							</label>
							<button type="submit">Save Page Draft</button>
							<p class="status" id="page-status"></p>
						</form>

						<section class="data-list">
							<h3>Saved Page Drafts</h3>
							<ul id="page-list">
								<li>
									<strong>Home</strong>
									<span>/</span>
									<span>Landing</span>
								</li>
								<li>
									<strong>Shop</strong>
									<span>/shop</span>
									<span>Product</span>
								</li>
								<li>
									<strong>Support</strong>
									<span>/support</span>
									<span>Service</span>
								</li>
							</ul>
						</section>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const authForm = document.querySelector('#auth-form');
			const authMessage = document.querySelector('#auth-message');
			const authBox = document.querySelector('#auth-box');
			const dashboard = document.querySelector('#dashboard');
			const logoutButton = document.querySelector('#logout');
			const tabButtons = Array.from(document.querySelectorAll('.tab-buttons button'));
			const tabContents = Array.from(document.querySelectorAll('.tab-content'));
			const productForm = document.querySelector('#product-form');
			const pageForm = document.querySelector('#page-form');
			const productList = document.querySelector('#product-list');
			const pageList = document.querySelector('#page-list');
			const productStatus = document.querySelector('#product-status');
			const pageStatus = document.querySelector('#page-status');

			const ADMIN_KEY = 'protech_admin_authenticated';
			const PRODUCT_STORE = 'protech_admin_products';
			const PAGE_STORE = 'protech_admin_pages';
			const ADMIN_PASSCODE = 'admin123';

			const setAuthenticated = (enabled) => {
				if (enabled) {
					localStorage.setItem(ADMIN_KEY, 'true');
					authBox?.classList.add('hidden');
					dashboard?.classList.remove('hidden');
					loadSavedItems();
				} else {
					localStorage.removeItem(ADMIN_KEY);
					authBox?.classList.remove('hidden');
					dashboard?.classList.add('hidden');
				}
			};

			const renderRecord = (target, values) => {
				const li = document.createElement('li');
				values.forEach((value, index) => {
					const el = document.createElement(index === 0 ? 'strong' : 'span');
					el.textContent = value;
					li.appendChild(el);
				});
				target?.appendChild(li);
			};

			const loadSavedItems = () => {
				const savedProducts = JSON.parse(localStorage.getItem(PRODUCT_STORE) || '[]');
				const savedPages = JSON.parse(localStorage.getItem(PAGE_STORE) || '[]');

				savedProducts.forEach((product) => {
					renderRecord(productList, [
						product.name,
						product.sku,
						`$${product.price}`,
						`${product.stock} units`,
					]);
				});

				savedPages.forEach((page) => {
					renderRecord(pageList, [page.title, `/${page.slug}`, page.category]);
				});
			};

			authForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				const formData = new FormData(authForm);
				const passcode = String(formData.get('passcode') || '');

				if (passcode === ADMIN_PASSCODE) {
					authMessage.textContent = 'Access granted. Dashboard unlocked.';
					authMessage.classList.add('success');
					setAuthenticated(true);
					authForm.reset();
					return;
				}

				authMessage.textContent = 'Invalid passcode. Please try again.';
				authMessage.classList.remove('success');
			});

			logoutButton?.addEventListener('click', () => {
				setAuthenticated(false);
				authMessage.textContent = 'Dashboard locked.';
				authMessage.classList.remove('success');
			});

			tabButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const tab = button.dataset.tab;
					tabButtons.forEach((item) => item.classList.remove('active'));
					tabContents.forEach((content) => content.classList.remove('active'));
					button.classList.add('active');
					document.querySelector(`#tab-${tab}`)?.classList.add('active');
				});
			});

			productForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				const formData = new FormData(productForm);
				const entry = {
					name: String(formData.get('name') || ''),
					sku: String(formData.get('sku') || ''),
					price: String(formData.get('price') || ''),
					stock: String(formData.get('stock') || ''),
					tag: String(formData.get('tag') || ''),
					description: String(formData.get('description') || ''),
				};

				const existing = JSON.parse(localStorage.getItem(PRODUCT_STORE) || '[]');
				existing.push(entry);
				localStorage.setItem(PRODUCT_STORE, JSON.stringify(existing));
				renderRecord(productList, [entry.name, entry.sku, `$${entry.price}`, `${entry.stock} units`]);
				productStatus.textContent = `Product "${entry.name}" added successfully.`;
				productStatus.classList.add('success');
				productForm.reset();
			});

			pageForm?.addEventListener('submit', (event) => {
				event.preventDefault();
				const formData = new FormData(pageForm);
				const entry = {
					title: String(formData.get('title') || ''),
					slug: String(formData.get('slug') || '').replace(/^\/+/, ''),
					category: String(formData.get('category') || ''),
					summary: String(formData.get('summary') || ''),
				};

				const existing = JSON.parse(localStorage.getItem(PAGE_STORE) || '[]');
				existing.push(entry);
				localStorage.setItem(PAGE_STORE, JSON.stringify(existing));
				renderRecord(pageList, [entry.title, `/${entry.slug}`, entry.category]);
				pageStatus.textContent = `Page draft "${entry.title}" saved.`;
				pageStatus.classList.add('success');
				pageForm.reset();
			});

			if (localStorage.getItem(ADMIN_KEY) === 'true') {
				setAuthenticated(true);
			}
		</script>
	</body>
</html>
