---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { supportChannels } from '../data/siteData';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | Support`}
			description="Request remote or on-site IT support, emergency cybersecurity response, and device repair services."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">Support Center</p>
				<h1>How can we help you today?</h1>
				<p>
					Choose a support channel below. Our team covers remote troubleshooting, urgent repairs, security
					incidents, and device deployment for both homes and businesses.
				</p>
			</section>

			<section class="support-grid">
				{supportChannels.map((channel) => (
					<article class="support-card">
						<h2>{channel.title}</h2>
						<p>{channel.description}</p>
						<p class="availability">Availability: {channel.availability}</p>
						<button type="button">{channel.cta}</button>
					</article>
				))}
			</section>

			<section class="ticket-panel">
				<h2>Quick ticket form</h2>
				<form class="ticket-form">
					<label>
						Full name
						<input type="text" name="name" placeholder="Your name" required />
					</label>
					<label>
						Work email
						<input type="email" name="email" placeholder="you@company.com" required />
					</label>
					<label>
						Priority
						<select name="priority">
							<option>Low</option>
							<option selected>Normal</option>
							<option>High</option>
							<option>Critical</option>
						</select>
					</label>
					<label>
						Issue summary
						<textarea
							name="issue"
							rows="5"
							placeholder="Describe the problem, affected device, and urgency."
						></textarea>
					</label>
					<button type="submit">Submit ticket</button>
				</form>
			</section>
		</main>
		<Footer />
	</body>
</html>
