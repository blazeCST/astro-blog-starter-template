---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | About Us`}
			description="Meet ProTech, a professional IT support and reparation team focused on quality and trust."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<p class="eyebrow">About Us</p>
				<h1>We keep your technology running smoothly.</h1>
				<p>
					ProTech IT Support was founded to provide clear, reliable, and professional technical help for
					companies and individuals. We combine fast repair capabilities with long-term IT strategy.
				</p>
			</section>

			<section class="about-grid">
				<article>
					<h2>Our mission</h2>
					<p>
						Deliver dependable IT services that reduce downtime, improve security posture, and help teams work
						confidently every day.
					</p>
				</article>
				<article>
					<h2>What we value</h2>
					<ul>
						<li>Transparency in scope, pricing, and timelines.</li>
						<li>Security-first thinking in every deployment.</li>
						<li>Ownership and accountability from first response to resolution.</li>
						<li>Continuous improvement through documentation and reporting.</li>
					</ul>
				</article>
				<article>
					<h2>Who we serve</h2>
					<p>
						We support startups, clinics, legal firms, design studios, and distributed teams that need
						high-quality IT operations without managing a large internal department.
					</p>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>
